# ============================================================
# 复制成 .env 后填入你的值：
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不会进入版本库。
# ============================================================

# ---- 面板登录令牌（必填）----
# 生成：openssl rand -hex 16
CONTROL_TOKEN=

# ---- 内核 API 密钥（必填，须与上面不同）----
# 生成：openssl rand -hex 16
CLASH_SECRET=

# ---- 面板预填的后端地址（一般不用改）----
DEFAULT_BACKEND_URL=http://127.0.0.1:9090

# ---- 时区 ----
TZ=Asia/Shanghai
