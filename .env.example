# ============================================================
# 复制成 .env 后填入你的真实值：
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不会进入版本库。
# ============================================================

# ---- 必填：内核控制密钥 ----
# 生成方法：openssl rand -hex 16
MIHOMO_SECRET=

# ---- 可选：订阅地址（逗号分隔多个）----
# 留空则启动后在管理页 http://127.0.0.1:18091 里添加
# SUB_URLS=https://example.com/sub?token=xxx,https://example.org/sub?token=yyy

# ---- 可选：节点筛选 ----
# REGION_WHITELIST=DE NL GB US JP SG FI DK
# MAX_DELAY=3000
# TEST_TIMEOUT=3000

# ---- 可选：时区 ----
# TZ=Asia/Shanghai
