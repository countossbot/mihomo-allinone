# ============================================================
# 复制成 .env 后填入你的值：
#   cp .env.example .env
# .env 已在 .gitignore 中，不会进入版本库。
# ============================================================

# ---- 密钥（必填）----
# 两个密钥用途不同，为省事可设为同一个值：
#   CONTROL_TOKEN  登录面板 UI 用
#   CLASH_SECRET   面板连接内核 API 用
# 生成：openssl rand -hex 16
CONTROL_TOKEN=
CLASH_SECRET=

# ---- 面板预填的后端地址 ----
# 这是【浏览器】访问的地址，不是容器内地址。
# 本地部署填宿主机映射的 API 端口；经反向代理则填反代路径。
DEFAULT_BACKEND_URL=http://127.0.0.1:19090

# ---- 宿主机端口（避开常见占用）----
PANEL_PORT=18080
API_PORT=19090
# PROXY_PORT=17890    # 需要宿主机连代理时，在 compose 里取消代理口注释

# ---- 时区 ----
TZ=Asia/Shanghai
